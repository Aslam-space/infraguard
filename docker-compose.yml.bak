version: '3.8'

services:

  infraguard-app:
    build: .
    container_name: infraguard-app
    ports:
      - "8080:8080"
    volumes:
      - ./data:/app/data
      - ./logs:/app/logs
      - ./scripts:/app/scripts
    env_file:
      - .env
    depends_on:
      - redis
    restart: always
    networks:
      - infranet

  redis:
    image: redis:7-alpine
    container_name: infraguard-redis
    ports:
      - "6379:6379"
    restart: always
    networks:
      - infranet

  node-exporter:
    image: prom/node-exporter:latest
    container_name: infraguard-node-exporter
    ports:
      - "9100:9100"
    restart: always
    networks:
      - infranet

  prometheus:
    image: prom/prometheus:latest
    container_name: infraguard-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
    restart: always
    networks:
      - infranet

  grafana:
    image: grafana/grafana:latest
    container_name: infraguard-grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=infraguard123
    restart: always
    networks:
      - infranet

  nginx:
    build: ./nginx
    container_name: infraguard-nginx
    ports:
      - "80:80"
    depends_on:
      - infraguard-app
    restart: always
    networks:
      - infranet

networks:
  infranet:
    driver: bridge
